// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema











generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
  role     String
}

model PaymentRecord {
  id             String          @id @default(uuid())
  date           DateTime        @default(now())
  amount         Decimal
  type           String
  customerId     String?
  supplierId     String?
  expenseId      String?
  scrapSaleId    String?
  idempotencyKey String?         @unique
  description    String?

  customer       Customer?       @relation(fields: [customerId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  expense        Expense?        @relation(fields: [expenseId], references: [id])
  scrapSale      ScrapInventory? @relation(fields: [scrapSaleId], references: [id])

  invoicePayments InvoicePayment[]
  billPayments    BillPayment[]

  status         String @default("APPROVED")

  @@index([date])
  @@index([customerId])
  @@index([supplierId])
}

model InvoicePayment {
  id              String        @id @default(uuid())
  paymentRecordId String
  saleId          String
  amountApplied   Decimal
  
  paymentRecord   PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([paymentRecordId])
  @@index([saleId])
}

model BillPayment {
  id              String        @id @default(uuid())
  paymentRecordId String
  purchaseId      String
  amountApplied   Decimal
  
  paymentRecord   PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([paymentRecordId])
  @@index([purchaseId])
}

model Employee {
  id            String          @id @default(uuid())
  name          String
  role          String // "Manager", "Worker", etc.
  baseSalary    Decimal // Base monthly salary
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attendances   Attendance[]
  advances      Advance[]
  salaryHistory SalaryHistory[]
}

model SalaryHistory {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  amount     Decimal
  reason     String?
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  date        DateTime
  status      String
  hoursWorked Decimal?
  employee    Employee         @relation(fields: [employeeId], references: [id])

  @@index([date])
  @@index([employeeId])
  @@unique([employeeId, date])
}

model Advance {
  id           String             @id @default(uuid())
  employeeId   String
  date         DateTime
  amount       Decimal
  amountRepaid Decimal            @default(0)
  reason       String?
  employee     Employee           @relation(fields: [employeeId], references: [id])
  repayments   AdvanceRepayment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId])
}

model AdvanceRepayment {
  id        String   @id @default(uuid())
  advanceId String
  date      DateTime @default(now())
  amount    Decimal
  advance   Advance  @relation(fields: [advanceId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advanceId])
  @@index([date])
}

model Supplier {
  id            String           @id @default(uuid())
  name          String
  contact       String?
  address       String?
  gst           String?
  pan           String?
  stateCode     String?
  bankDetails   String?
  creditBalance Decimal          @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  purchases     Purchase[]
  ledgers       SupplierLedger[]
  payments      PaymentRecord[]
}

model Customer {
  id            String           @id @default(uuid())
  name          String
  contact       String?
  address       String?
  gst           String?
  stateCode     String?
  pan           String?
  transport     String?
  creditBalance Decimal          @default(0)
  creditLimit   Decimal          @default(7000000) // Default 70 Lakhs
  creditDays    Int              @default(18)      // Default 18 Days
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sales         Sale[]
  ledgers       CustomerLedger[]
  payments      PaymentRecord[]
  saudaContracts SaudaContract[]
}

model Purchase {
  id             String          @id @default(uuid())
  supplierId     String
  date           DateTime
  fullyPaidDate  DateTime?
  qty            Decimal         // Tons of raw copper
  pricePerTon    Decimal
  totalValue     Decimal
  amountPaid     Decimal         @default(0)
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  inventoryBatch InventoryBatch?
  billPayments   BillPayment[]
  debitNotes     DebitNote[]
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([date])
  @@index([supplierId])
}

model InventoryBatch {
  id           String   @id @default(uuid())
  purchaseId   String   @unique
  date         DateTime
  initialQty   Decimal
  remainingQty Decimal
  pricePerTon  Decimal
  purchase     Purchase @relation(fields: [purchaseId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([remainingQty])
}

model Production {
  id              String   @id @default(uuid())
  date            DateTime
  rawCopperUsed   Decimal // Tons
  productCategory String // "CC Wires", "Submersible Winding Wire"
  brand           String? // e.g. "Poly Vansh", "Poly Lifeline"
  wireType        String // e.g., "1mm", "2mm"
  wireProduced    Decimal // Tons
  estimatedOverhead Decimal @default(0)
  scrapGenerated  Decimal  @default(0) // Automatically tracked difference (rawUsed - wireProduced)
  isDeleted       Boolean  @default(false)
  finishedGoodsBatch FinishedGoodsBatch?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

model FinishedGoodsBatch {
  id              String        @id @default(uuid())
  productionId    String        @unique
  date            DateTime
  productCategory String
  brand           String?
  wireType        String
  initialQty      Decimal
  remainingQty    Decimal
  costPerTon      Decimal       // Exact FIFO cost inherited from raw copper consumed
  
  production      Production    @relation(fields: [productionId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
  @@index([productCategory, brand, wireType])
  @@index([remainingQty])
}

model ScrapInventory {
  id        String    @id @default(uuid())
  date      DateTime  @default(now())
  type      String    // "GENERATED", "SOLD", "PROCESS_LOSS_ADJUSTMENT"
  qty       Decimal   // Tons
  revenue   Decimal   @default(0) // Money earned if sold
  notes     String?
  isDeleted Boolean   @default(false)
  
  payments  PaymentRecord[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([date])
  @@index([type])
}

model SaudaContract {
  id              String     @id @default(uuid())
  contractNo      String     @unique
  customerId      String
  bookingDate     DateTime   @default(now())
  expiryDate      DateTime?
  ratePerKg       Decimal    // Booked Rate in ₹/Kg
  totalQtyTons    Decimal    // Booked Quantity in Tons
  remainingQty    Decimal    // Remaining Quantity to dispatch in Tons
  status          String     @default("ACTIVE") // "ACTIVE", "COMPLETED", "CANCELLED"
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customer        Customer   @relation(fields: [customerId], references: [id])
  saleItems       SaleItem[]

  @@index([customerId])
  @@index([status])
}

model Sale {
  id              String           @id @default(uuid())
  customerId      String
  date            DateTime
  fullyPaidDate   DateTime?
  totalValue      Decimal
  amountPaid      Decimal          @default(0)
  customer        Customer         @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  invoicePayments InvoicePayment[]
  creditNotes     CreditNote[]
  isDeleted       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([date])
  @@index([customerId])
}

model SaleItem {
  id                  String         @id @default(uuid())
  saleId              String
  saudaContractId     String?
  productCategory     String         // "CC Wires", "Submersible Winding Wire", "Raw Copper Bundle"
  brand               String?        // Optional for raw copper
  wireType            String?        // Optional for raw copper
  qty                 Decimal        // Tons
  pricePerTon         Decimal
  totalValue          Decimal
  rawCopperCostAtSale Decimal        @default(0) // The exact FIFO cost of raw copper per ton on the day this was sold. Essential for exact profit calculations.
  hsnCode             String?
  sale                Sale           @relation(fields: [saleId], references: [id])
  saudaContract       SaudaContract? @relation(fields: [saudaContractId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([saleId])
  @@index([saudaContractId])
}

model Expense {
  id           String        @id @default(uuid())
  date         DateTime
  category     String // "Electricity", "Rent", "Maintenance", "Water", "Other"
  amount       Decimal
  description  String?
  expenseMonth String? // e.g. "January 2024"
  status       String @default("UNPAID")
  isDeleted    Boolean       @default(false)
  
  payments     PaymentRecord[]

  @@index([date])
  @@index([category])
}

model MarketPrice {
  id        String   @id @default(uuid())
  date      DateTime
  price     Decimal // Price per Ton of raw copper
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@unique([date])
}

model SupplierLedger {
  id          String   @id @default(uuid())
  supplierId  String
  date        DateTime
  amount      Decimal // Positive means we owe them (Invoice), Negative means we paid them (Payment)
  description String?
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  isDeleted   Boolean  @default(false)

  @@index([supplierId])
  @@index([date])
}

model CustomerLedger {
  id          String   @id @default(uuid())
  customerId  String
  date        DateTime
  amount      Decimal // Positive means they owe us (Invoice), Negative means they paid us (Payment)
  description String?
  customer    Customer @relation(fields: [customerId], references: [id])
  isDeleted   Boolean  @default(false)

  @@index([customerId])
  @@index([date])
}

model AuditLog {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  user        String // "manager" or "owner"
  action      String // "CREATE", "UPDATE", "DELETE"
  module      String // "Sales", "Purchases", "Production", etc.
  description String // Human readable summary
  details     String? // JSON string of old/new values

  @@index([date])
  @@index([module])
}



model JournalEntry {
  id            String        @id @default(uuid())
  date          DateTime      @default(now())
  description   String
  referenceType String?       // "SALE", "PURCHASE", "PAYMENT", "EXPENSE", "ADVANCE", "CREDIT_NOTE", "DEBIT_NOTE"
  referenceId   String?       // Reference ID of source record
  lines         JournalLine[]
  createdAt     DateTime      @default(now())

  @@index([date])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountName    String       // e.g. "Accounts Receivable", "Accounts Payable", "Cash & Bank", "Sales Revenue", "COGS", "Factory Expenses", "Scrap Revenue"
  accountType    String       // "ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountName])
}

model CreditNote {
  id             String   @id @default(uuid())
  date           DateTime @default(now())
  saleId         String
  qtyReturned    Decimal  // Tons returned
  amountCredited Decimal  // Reduction in Customer AR
  reason         String?
  sale           Sale     @relation(fields: [saleId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([saleId])
}

model DebitNote {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  purchaseId    String
  qtyReturned   Decimal  // Tons returned
  amountDebited Decimal  // Reduction in Supplier AP
  reason        String?
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([purchaseId])
}

model PeriodLock {
  id        String   @id @default(uuid())
  yearMonth String   @unique // "YYYY-MM" format, e.g. "2026-05"
  locked    Boolean  @default(true)
  lockedAt  DateTime @default(now())
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  status    String   // "PROCESSING", "SUCCESS", "FAILED"
  response  String?  // Stringified JSON response
  createdAt DateTime @default(now())
}

model LoginAttempt {
  key         String    @id
  count       Int       @default(0)
  lastAttempt DateTime  @default(now())
  lockedUntil DateTime?
}

